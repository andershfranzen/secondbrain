{
  "name": "secondbrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "connect:chatgpt": "tsx scripts/connect-chatgpt.ts",
    "models:chatgpt": "tsx scripts/chatgpt-models.ts",
    "disconnect:chatgpt": "tsx scripts/disconnect-chatgpt.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "ops": "tsx scripts/operations.ts",
    "format": "prettier --write apps packages/*/src scripts tests *.ts *.json *.yaml",
    "test:integration": "vitest run tests/integration.test.ts",
    "eval:agent": "tsx scripts/evaluate-agent.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@secondbrain/ai": "workspace:*",
    "@secondbrain/database": "workspace:*",
    "@secondbrain/memory": "workspace:*",
    "@secondbrain/shared": "workspace:*",
    "archiver": "8.0.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.17",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.7",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "openai": "7.39.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
