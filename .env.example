DATABASE_URL=postgres://secondbrain:replace-me@127.0.0.1:5432/secondbrain
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Run pnpm setup to generate this and a private password hash file.
SESSION_SECRET=
AI_PROVIDER=none
# Use chatgpt after running pnpm connect:chatgpt for subscription-backed text AI.
CHATGPT_CREDENTIALS_PATH=./secrets/chatgpt.json
AI_API_KEY=
# Select models supported by your account; no cloud calls until consent.
# REASONING_MODEL runs the memory agent (tool calling + structured outputs).
REASONING_MODEL=
TRANSCRIPTION_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Morning brief: one push a day at BRIEF_TIME (user's timezone) through ntfy,
# on days with something overdue, due, starting or gone quiet. Off without NTFY_URL.
NTFY_URL=
NTFY_TOPIC=second-brain
NTFY_TOKEN=
BRIEF_TIME=07:30
